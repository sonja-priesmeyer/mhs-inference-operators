query(q).
conjunction(q, q_1, q_2).
disjunction(q_1, q_1_1, q_1_2).
atomic_formula(q_1_1, a0).
atomic_formula(q_1_2, a1).
negation(q_2, q_2_1).
disjunction(q_2_1, q_2_1_1, q_2_1_2).
negation(q_2_1_1, q_2_1_1_1).
atomic_formula(q_2_1_1_1, a0).
negation(q_2_1_2, q_2_1_2_1).
atomic_formula(q_2_1_2_1, a3).
