query(q).
conjunction(q, q_1, q_2).
negation(q_1, q_1_1).
disjunction(q_1_1, q_1_1_1, q_1_1_2).
atomic_formula(q_1_1_1, a0).
atomic_formula(q_1_1_2, a3).
disjunction(q_2, q_2_l, q_2_n).
atomic_formula(q_2_l, a0).
disjunction(q_2_n, q_2_n_l, q_2_n_r).
atomic_formula(q_2_n_l, a4).
conjunction(q_2_n_r, q_2_n_r_1, q_2_n_r_2).
atomic_formula(q_2_n_r_1, a0).
atomic_formula(q_2_n_r_2, a2).
