query(q).
disjunction(q, q_1, q_2).
conjunction(q_1, q_1_l, q_1_n).
atomic_formula(q_1_l, a0).
conjunction(q_1_n, q_1_n_l, q_1_n_r).
atomic_formula(q_1_n_l, a1).
atomic_formula(q_1_n_r, a2).
negation(q_2, q_2_1).
conjunction(q_2_1, q_2_1_1, q_2_1_2).
atomic_formula(q_2_1_1, a0).
atomic_formula(q_2_1_2, a2).
