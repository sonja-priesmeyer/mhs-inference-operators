query(q).
disjunction(q, q_1, q_2).
conjunction(q_1, q_1_1, q_1_2).
atomic_formula(q_1_1, a2).
negation(q_1_2, q_1_2_1).
atomic_formula(q_1_2_1, a0).
conjunction(q_2, q_2_l, q_2_n).
atomic_formula(q_2_l, a0).
conjunction(q_2_n, q_2_n_l, q_2_n_n).
atomic_formula(q_2_n_l, a2).
conjunction(q_2_n_n, q_2_n_n_l, q_2_n_n_r).
negation(q_2_n_n_l, q_2_n_n_l_1).
atomic_formula(q_2_n_n_l_1, a2).
negation(q_2_n_n_r, q_2_n_n_r_1).
disjunction(q_2_n_n_r_1, q_2_n_n_r_1_1, q_2_n_n_r_1_2).
atomic_formula(q_2_n_n_r_1_1, a0).
atomic_formula(q_2_n_n_r_1_2, a2).
